# ==============================================================
# PERSONAL AI CALL ASSISTANT — ENVIRONMENT CONFIGURATION
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file with production credentials to git!

# Telephony Provider Selection: 'simulated' (free demo), 'twilio', or 'exotel'
TELEPHONY_PROVIDER=simulated

# Owner's Mobile Number (Calls forwarded from this number when unanswered)
OWNER_PHONE=+918094725777
OWNER_NAME=Owner

# Assistant Language: 'en' for English (default), 'hi' for Hindi
ASSISTANT_LANGUAGE=en

# Public Base URL for Webhook callbacks (e.g. https://your-domain.ngrok-free.app or cloud domain)
WEBHOOK_BASE_URL=http://localhost:8000

# ==============================================================
# TWILIO CREDENTIALS (Optional - required only for live Twilio calls)
# ==============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================
# EXOTEL CREDENTIALS (Optional - required only for live Exotel India calls)
# ==============================================================
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
